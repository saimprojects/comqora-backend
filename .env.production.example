# Railway web and worker variables. Never commit real secrets.
DEBUG=False
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
# Use a Railway reference to your PostgreSQL service, not this placeholder.
DATABASE_URL=${{Postgres.DATABASE_URL}}
ALLOWED_HOSTS=comqora.com,www.comqora.com,comqora.up.railway.app,healthcheck.railway.app
# RAILWAY_PUBLIC_DOMAIN is supplied by Railway after Generate Domain.
FRONTEND_URL=https://comqora.com
CORS_ALLOWED_ORIGINS=https://comqora.com,https://www.comqora.com
CSRF_TRUSTED_ORIGINS=https://comqora.com,https://www.comqora.com
SECURE_SSL_REDIRECT=True
DB_CONN_MAX_AGE=60
NUM_PROXIES=1
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
REQUIRE_EMAIL_VERIFICATION=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Comqora <no-reply@comqora.com>
PUBLIC_BUSINESS_NAME=Comqora
PUBLIC_SUPPORT_EMAIL=support@mostmailer.com
PUBLIC_BUSINESS_ADDRESS=Kasur, Punjab, Pakistan
PUBLIC_LEGAL_REVIEWED=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TRACKING_ENABLED=True
TRACKING_POLL_SECONDS=60
POSTEX_API_TOKEN=
TRACKING_WEBHOOK_SECRET=
WAHA_ENABLED=False
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION_MODE=MULTI
WAHA_WEBHOOK_SECRET=
WAHA_WEBHOOK_URL=https://comqora.up.railway.app/api/whatsapp/webhook/
FAZITA_API_KEY=
# Same stable key on web AND worker; encrypted AI credentials depend on it.
# During planned rotation, retain the old key here until credentials are re-encrypted.
SECRET_KEY_FALLBACKS=
