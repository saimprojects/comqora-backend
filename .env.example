DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:5432/sellflow
REQUIRE_EMAIL_VERIFICATION=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP server hostname, never an email address (Gmail: smtp.gmail.com).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_TIMEOUT=10
# Gmail requires the full email address here and an App Password below.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Verify this sender with your SMTP provider before sending production email.
DEFAULT_FROM_EMAIL=Comqora <no-reply@comqora.com>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TRACKING_WEBHOOK_SECRET=
# Tracking worker: python manage.py sync_tracking --loop
TRACKING_ENABLED=True
TRACKING_POLL_SECONDS=60
POSTEX_API_TOKEN=
# This server-side merchant token is shared by all workspaces.

# Self-hosted WAHA. Keep disabled until pairing and notification preferences are reviewed.
WAHA_ENABLED=False
PUBLIC_BUSINESS_NAME=Comqora
PUBLIC_SUPPORT_EMAIL=support@mostmailer.com
PUBLIC_BUSINESS_ADDRESS=Kasur, Punjab, Pakistan
# Set True only after reviewing the legal pages for your business and jurisdiction.
PUBLIC_LEGAL_REVIEWED=False
WAHA_BASE_URL=https://whatsapp.example.com
WAHA_API_KEY=
# MULTI = separate WhatsApp session per seller workspace (WAHA >= 2026.6.1).
# CORE is legacy single-session compatibility; PLUS is a legacy alias for MULTI.
WAHA_SESSION_MODE=MULTI
# Only required for legacy CORE mode; leave empty for MULTI.
WAHA_CORE_WORKSPACE_ID=
WAHA_ALLOW_HTTP=False
# Configure WAHA's message webhook with this HMAC key (sha512).
WAHA_WEBHOOK_SECRET=
WAHA_WEBHOOK_URL=https://api.example.com/api/whatsapp/webhook/
# Public frontend origin used for unsubscribe links; use your HTTPS domain in production.
FRONTEND_URL=http://localhost:5173

# Optional AI Manager fallback. Prefer pasting the key in Jazzmin > AI provider connections.
FAZITA_API_KEY=
